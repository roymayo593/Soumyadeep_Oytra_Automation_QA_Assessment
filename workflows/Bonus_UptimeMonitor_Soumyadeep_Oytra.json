          "conditions": [
            {
              "id": "first-health-check",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "first-if",
      "name": "First Attempt Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
