              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "ping-app",
      "name": "Ping RealWorld App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-340, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const start = $('Start Response Timer').first().json;\nconst statusCode = Number(items[0]?.json?.statusCode || 0);\nreturn [{ json: {\n  checkedAt: new Date().toISOString(),\n  target: start.target,\n  statusCode,\n  responseTimeMs: Date.now() - start.startedMs,\n  healthy: statusCode === 200,\n  attempt: 1\n} }];"
      },
      "id": "evaluate-first",
      "name": "Evaluate First Attempt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 0]
