{
  "name": "Soumyadeep Oytra - Hacker News Morning Brief",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Test Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-900, 80]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-900, -80]
    },
    {
      "parameters": {
        "url": "https://hn.algolia.com/api/v1/search?tags=front_page",
        "options": {
          "timeout": 15000
        }
      },
      "id": "fetch-top-ids",
      "name": "Fetch Top Story IDs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-680, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const hits = items[0]?.json?.hits;\nif (!Array.isArray(hits) || hits.length === 0) {\n  throw new Error('Hacker News returned no stories');\n}\nreturn hits.slice(0, 5).map((story, index) => ({\n  json: { id: Number(story.objectID), rank: index + 1 }\n}));"
      },
      "id": "select-top-five",
      "name": "Keep Top 5 IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-440, 0]
    },
    {
      "parameters": {
        "url": "=https://hacker-news.firebaseio.com/v0/item/{{ $json.id }}.json",
        "options": {
          "timeout": 15000
        }
      },
      "id": "fetch-story-details",
      "name": "Enrich Story Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "return items\n  .filter(item => item.json && item.json.type === 'story' && !item.json.deleted && !item.json.dead)\n  .sort((a, b) => (b.json.score || 0) - (a.json.score || 0))\n  .slice(0, 5)\n  .map((item, index) => ({ json: {\n    runTime: new Date().toISOString(),\n    rank: index + 1,\n    title: item.json.title || '(untitled)',\n    score: item.json.score || 0,\n    author: item.json.by || 'unknown',\n    storyUrl: item.json.url || `https://news.ycombinator.com/item?id=${item.json.id}`,\n    enrichedCommentCount: item.json.descendants || 0,\n    status: 'READY'\n  } }));"
      },
      "id": "sort-format",
      "name": "Sort and Format Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "score-threshold",
              "leftValue": "={{ $json.score }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "score-if",
      "name": "Score Above 200?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [280, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "high-branch",
              "name": "branch",
              "value": "High score (>200)",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "tag-high",
      "name": "Tag High Score",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, -120]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "standard-branch",
              "name": "branch",
              "value": "Standard score (<=200)",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "tag-standard",
      "name": "Tag Standard Score",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, 120]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "merge-branches",
      "name": "Merge Digest Branches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [760, 0]
    },
    {
      "parameters": {
        "jsCode": "const records = items.map((item) => item.json).sort((a, b) => a.rank - b.rank);\nif (records.length !== 5) {\n  throw new Error(`Expected 5 digest rows, received ${records.length}`);\n}\nreturn [{ json: { records } }];"
      },
      "id": "bundle-output",
      "name": "Bundle Sorted Sheet Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 0]
    },
  {
    "parameters": {
      "method": "POST",
      "url": "https://script.google.com/macros/s/REPLACE_WITH_APPS_SCRIPT_DEPLOYMENT_ID/exec",
      "sendBody": true,
      "contentType": "raw",
      "rawContentType": "application/json",
      "body": "={{ JSON.stringify($json.records) }}",
      "options": {
        "timeout": 15000
      }
      },
      "id": "write-sheet",
      "name": "Append Digest to Google Sheet",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.2,
      "position": [1120, 0]
    },
    {
      "parameters": {
        "jsCode": "const message = items[0]?.json?.error?.message || items[0]?.json?.message || 'Unknown API failure';\nreturn [{ json: {\n  runTime: new Date().toISOString(),\n  branch: 'Error fallback',\n  rank: 0,\n  title: message,\n  score: 0,\n  author: 'n8n',\n  storyUrl: '',\n  enrichedCommentCount: 0,\n  status: 'ERROR_LOGGED'\n} }];"
      },
      "id": "build-error",
      "name": "Build Error Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-200, 300]
    },
  {
    "parameters": {
      "method": "POST",
      "url": "https://script.google.com/macros/s/REPLACE_WITH_APPS_SCRIPT_DEPLOYMENT_ID/exec",
      "sendBody": true,
      "contentType": "raw",
      "rawContentType": "application/json",
      "body": "={{ JSON.stringify($json) }}",
      "options": {
        "timeout": 15000
      }
      },
      "id": "write-error-sheet",
      "name": "Log Error to Google Sheet",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.2,
      "position": [40, 300]
    }
  ],
